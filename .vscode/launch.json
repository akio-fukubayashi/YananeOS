{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "GDB Remote Debug(ASM)",
            "type": "cppdbg",
            "request": "launch",
            "MIMode": "gdb",
            "miDebuggerServerAddress": "localhost:1234",
            "targetArchitecture": "x86",
            "miDebuggerPath": "gdb",
            "program": "${workspaceFolder}/build/bin/kernel.elf",        
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "setupCommands": [
                {
                "description": "Enable pretty-printing for gdb",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
                },
                {
                    "text": "set architecture i8086",
                    "description": "Set 16-bit mode"
                },
                {
                    "text": "b *0x7C00",
                    "description": "Set Bootloader Breakpoint"
                }
            ]
        },
        {
            "name": "GDB Remote Debug(C++)",
            "type": "cppdbg",
            "request": "launch",
            "MIMode": "gdb",
            "miDebuggerServerAddress": "localhost:1234",
            "targetArchitecture": "x86",
            "miDebuggerPath": "gdb",
            "program": "${workspaceFolder}/build/bin/kernel.elf",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": true,
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                },
                {
                    "text": "set architecture i386",
                    "description": "Set 32-bit mode"
                },
                {
                    "description": "Add symbol file for kernel",
                    "text": "add-symbol-file ${workspaceFolder}/build/bin/kernel.elf 0x10000"
                },
            ],
            
        }
    ]
}